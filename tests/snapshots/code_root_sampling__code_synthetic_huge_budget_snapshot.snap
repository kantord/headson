1931: function detailSegment(cluster, lane, pulse, depth) {
1932:   const marker = `${cluster}-${lane}-${pulse}-${depth}`;
1933:   if (!PLANETARY_REGISTRY.has(marker)) {
1934:     PLANETARY_REGISTRY.set(marker, []);
